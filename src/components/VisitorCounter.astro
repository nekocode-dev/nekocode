---
const { class: className } = Astro.props;

// Get the Google Script URL from environment variable
// Single URL handles all features (contact, bug reports, visitor counter, testimonials)
const scriptUrl = import.meta.env.PUBLIC_GOOGLE_SCRIPT_URL || '';
---

<visitor-counter class={className} data-script-url={scriptUrl} data-state="loading">
  <div class="counter-container" title="Unique Visitors">
    <span class="status-dot" aria-hidden="true"></span>
    <span class="label">Unique visitors</span>
    <span class="count" aria-live="polite">…</span>
  </div>
</visitor-counter>

<style>
  .counter-container {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-text);
    font-size: 12px;
    color: var(--color-text-secondary);
    padding-block: 2px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    background-color: var(--color-muted);
    border-radius: 50%;
  }

  visitor-counter[data-state="ready"] .status-dot { background-color: #328256; }
  .label { font-weight: 500; }

  .count {
    font-weight: 600;
    min-width: 2ch;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }
</style>

<script>
  class VisitorCounter extends HTMLElement {
    initialized = false;

    connectedCallback() {
      if (this.initialized) return;
      this.initialized = true;
      this.init();
    }

    /**
     * Generate a simple browser fingerprint for more accurate unique visitor tracking.
     * This combines multiple browser attributes into a hash for better uniqueness
     * than localStorage alone.
     */
    generateFingerprint() {
      const components = [
        navigator.userAgent,
        navigator.language,
        screen.width + 'x' + screen.height,
        screen.colorDepth,
        new Date().getTimezoneOffset(),
        navigator.hardwareConcurrency || 'unknown',
        (navigator as Navigator & { deviceMemory?: number }).deviceMemory || 'unknown',
        navigator.platform || 'unknown'
      ];
      
      // Simple hash function (djb2)
      const str = components.join('|');
      let hash = 5381;
      for (let i = 0; i < str.length; i++) {
        hash = ((hash << 5) + hash) + str.charCodeAt(i);
      }
      return 'fp_' + Math.abs(hash).toString(36);
    }

    async init() {
      const scriptUrl = this.dataset.scriptUrl;
      const countElement = this.querySelector('.count');
      if (!countElement) return;
      if (!scriptUrl) {
        countElement.textContent = '—';
        this.dataset.state = 'unavailable';
        return;
      }

      try {

        const fingerprintKey = 'neko_visitor_fp';
        const recordedKey = 'neko_visitor_recorded';
        const sessionKey = 'neko_session_counted';

        let fingerprint = localStorage.getItem(fingerprintKey);
        if (!fingerprint) {
          fingerprint = this.generateFingerprint();
          localStorage.setItem(fingerprintKey, fingerprint);
        }

        // Preserve the existing service contract: only count a visitor once.
        const shouldIncrement = !localStorage.getItem(recordedKey);
        const action = shouldIncrement ? 'increment_visitor' : 'get_count';

        const url = new URL(scriptUrl);
        url.searchParams.set('action', action);
        if (shouldIncrement) {
          url.searchParams.set('fingerprint', fingerprint);
        }
        
        const response = await fetch(url.toString());
        
        if (!response.ok) throw new Error('Network response was not ok');
        
        const data = await response.json();
        
        if (typeof data.count === 'number' && Number.isFinite(data.count) && data.count >= 0) {
          // Format number with locale (e.g., 1,024)
          countElement.textContent = new Intl.NumberFormat('en-US').format(data.count);
          this.dataset.state = 'ready';
          
          if (shouldIncrement) {
            localStorage.setItem(recordedKey, fingerprint);
          }
          // Mark this session as counted to prevent re-counting on SPA navigation
          sessionStorage.setItem(sessionKey, 'true');
        } else {
          throw new Error('Invalid visitor count');
        }
      } catch (err) {
        console.error('Visitor counter error:', err);
        countElement.textContent = '—';
        this.dataset.state = 'unavailable';
      }
    }
  }

  if (!customElements.get('visitor-counter')) customElements.define('visitor-counter', VisitorCounter);
</script>
