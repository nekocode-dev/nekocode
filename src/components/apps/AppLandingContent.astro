---
import AppStoreLinks from '@/components/apps/AppStoreLinks.astro';
import type { AppLandingConfig } from '@/data/appLanding';

interface Props {
  app: AppLandingConfig;
}

const { app } = Astro.props;
const base = import.meta.env.BASE_URL;
const resolveAsset = (path: string) => (path.startsWith('/') ? `${base}${path.slice(1)}` : path);
---

<div
  data-testid="app-landing"
  class="app-landing"
  style={`--app-accent: ${app.theme.accent}; --app-accent-rgb: ${app.theme.accentRgb}; --app-accent-contrast: ${app.theme.accentContrast}; --app-glow: ${app.theme.glow};`}
>
  <section class="app-hero" aria-labelledby={`${app.slug}-title`}>
    <div class="app-container hero-grid">
      <div class="hero-copy">
        <a href={`${base}apps`} class="breadcrumb">Apps / {app.name}</a>
        <p class="availability">{app.availability}</p>
        <h1 id={`${app.slug}-title`} class="app-title">{app.heroHeadline}</h1>
        <p class="hero-description">{app.heroDescription}</p>

        <div class="hero-actions">
          <AppStoreLinks links={app.storeLinks} />
          <a href="#workflow" class="secondary-action">See app flow</a>
        </div>

        <ul class="platform-list" aria-label={`${app.name} platform notes`}>
          {app.platformNotes.map((note) => <li>{note}</li>)}
        </ul>
      </div>

      <div class="product-stage" aria-label={`${app.name} product preview`}>
        <div class="device-preview">
          <div class="device-screen" data-testid="phone-mockup-screen">
            <img class="screen-backdrop" src={resolveAsset(app.heroImage)} alt="" loading="eager" decoding="async" />
            <div class="screen-content">
              <img
                data-testid="phone-mockup-icon"
                class="mockup-icon"
                src={resolveAsset(app.icon)}
                alt={`${app.name} app icon`}
                width="128"
                height="128"
                loading="eager"
                decoding="async"
              />
              <div class="mockup-copy">
                <p>{app.name}</p>
                <span>{app.category}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="app-card">
          <img src={resolveAsset(app.icon)} alt="" width="56" height="56" />
          <div>
            <p>{app.name}</p>
            <span>{app.category}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="stat-band" aria-label={`${app.name} app highlights`}>
    <div class="app-container">
      <div class="stat-grid" data-testid="app-stat-values">
        {app.stats.map((stat) => (
          <div class="stat-item">
            <strong>{stat.title}</strong>
            <span>{stat.description}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="workflow" class="content-section">
    <div class="app-container split-heading">
      <div>
        <p class="section-label">Product flow</p>
        <h2>How it works</h2>
      </div>
      <p>
        Start with the main action, then move through the loop that makes the app useful day after day.
      </p>
    </div>

    <div class="app-container workflow-grid">
      {app.workflow.map((item, index) => (
        <article class="workflow-card">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="features" class="content-section feature-section">
    <div class="app-container feature-layout">
      <div class="feature-intro">
        <p class="section-label">App details</p>
        <h2>Designed around the core loop</h2>
        <p>
          Each product keeps the important actions close: what it does, why it matters, and how users keep momentum.
        </p>
      </div>

      <div class="feature-list">
        {app.features.map((feature) => (
          <article class="feature-row">
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="download" class="download-section">
    <div class="app-container download-panel">
      <div class="download-copy">
        <img src={resolveAsset(app.icon)} alt="" width="72" height="72" />
        <div>
          <p class="section-label">Download</p>
          <h2>Get {app.name}</h2>
          <p>{app.downloadDescription}</p>
        </div>
      </div>

      <div class="download-actions">
        <AppStoreLinks links={app.storeLinks} />
        <p>{app.downloadNote}</p>
      </div>
    </div>
  </section>

  <section id="faq" class="content-section faq-section">
    <div class="app-container split-heading">
      <div>
        <p class="section-label">Support</p>
        <h2>Frequently asked questions</h2>
      </div>
      <p>
        Clear answers for availability, platform support, privacy posture, and the next support path.
      </p>
    </div>

    <div class="app-container faq-grid">
      {app.faqs.map((faq) => (
        <article class="faq-item">
          <h3>{faq.title}</h3>
          <p>{faq.description}</p>
        </article>
      ))}
    </div>

    {app.legalLinks.length > 0 && (
      <div class="app-container legal-links">
        {app.legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    )}
  </section>
</div>

<style>
  .app-landing {
    position: relative;
    isolation: isolate;
    color: var(--color-text);
  }

  .app-landing::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(circle at 78% 16%, rgba(var(--app-accent-rgb), 0.18), transparent 34%),
      radial-gradient(circle at 12% 84%, color-mix(in srgb, var(--app-glow), transparent 80%), transparent 38%);
  }

  .app-container {
    width: min(100% - 48px, 1180px);
    margin-inline: auto;
  }

  .app-hero {
    min-height: calc(100svh - 88px);
    display: grid;
    align-items: center;
    padding-block: var(--space-20) var(--space-16);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.82fr);
    align-items: center;
    gap: clamp(var(--space-10), 7vw, var(--space-20));
  }

  .hero-copy {
    max-width: 710px;
  }

  .breadcrumb {
    display: inline-flex;
    margin-bottom: var(--space-5);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .breadcrumb:hover {
    color: var(--color-text);
  }

  .availability {
    margin-bottom: var(--space-4);
    color: var(--app-accent);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .app-title {
    max-width: 820px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 7.2vw, 6.8rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: 0;
  }

  .hero-description {
    max-width: 620px;
    margin-top: var(--space-6);
    color: var(--color-text-secondary);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .secondary-action {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-5);
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .platform-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .platform-list li {
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .product-stage {
    position: relative;
    min-height: 560px;
    display: grid;
    place-items: center;
  }

  .product-stage::before {
    content: '';
    position: absolute;
    inset: 8% 2%;
    z-index: -1;
    background:
      linear-gradient(135deg, rgba(var(--app-accent-rgb), 0.1), rgba(255, 255, 255, 0.025)),
      radial-gradient(circle at 50% 36%, rgba(var(--app-accent-rgb), 0.18), transparent 62%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 32px;
  }

  .device-preview {
    width: min(320px, 75vw);
    aspect-ratio: 9 / 17.8;
    padding: 12px;
    background: #050507;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 42px;
    box-shadow:
      0 28px 70px rgba(0, 0, 0, 0.48),
      0 0 48px rgba(var(--app-accent-rgb), 0.16);
  }

  .device-screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 26%, rgba(var(--app-accent-rgb), 0.22), transparent 46%),
      linear-gradient(180deg, #090911 0%, #111018 52%, #09090e 100%);
    border-radius: 32px;
  }

  .device-screen::before {
    content: '';
    position: absolute;
    top: 14px;
    left: 50%;
    z-index: 2;
    width: 84px;
    height: 22px;
    background: #050507;
    border-radius: var(--radius-full);
    transform: translateX(-50%);
  }

  .screen-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(28px) saturate(1.24);
    opacity: 0.5;
    transform: scale(1.16);
  }

  .device-screen::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.08), transparent 22%, rgba(0, 0, 0, 0.32)),
      linear-gradient(140deg, transparent 0 42%, rgba(255, 255, 255, 0.08) 44%, transparent 49%);
    pointer-events: none;
  }

  .screen-content {
    position: relative;
    z-index: 1;
    width: min(74%, 210px);
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding-top: 28px;
    text-align: center;
  }

  .mockup-icon {
    width: clamp(104px, 42%, 132px);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 30px;
    box-shadow:
      0 18px 42px rgba(0, 0, 0, 0.42),
      0 0 38px rgba(var(--app-accent-rgb), 0.32);
  }

  .mockup-copy {
    width: 100%;
    padding: var(--space-4);
    background: rgba(8, 8, 12, 0.54);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 22px;
    backdrop-filter: blur(18px);
  }

  .mockup-copy p {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    line-height: 1.1;
  }

  .mockup-copy span {
    display: block;
    margin-top: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .app-card {
    position: absolute;
    right: 0;
    bottom: 80px;
    max-width: 280px;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: rgba(16, 16, 20, 0.84);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    backdrop-filter: blur(16px);
  }

  .app-card img,
  .download-copy img {
    border-radius: 18px;
    object-fit: cover;
  }

  .app-card p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
  }

  .app-card span {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .stat-band {
    padding-block: 0 var(--space-16);
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--color-border);
  }

  .stat-item {
    min-height: 116px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-5);
    border-right: 1px solid var(--color-border);
  }

  .stat-item:last-child {
    border-right: none;
  }

  .stat-item strong {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.3rem);
    line-height: 1;
    color: var(--app-accent);
  }

  .stat-item span {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .content-section {
    padding-block: var(--space-20);
  }

  .split-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(280px, 0.65fr);
    gap: var(--space-8);
    align-items: end;
    margin-bottom: var(--space-8);
  }

  .section-label {
    margin: 0 0 var(--space-3);
    color: var(--app-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .split-heading h2,
  .feature-intro h2,
  .download-copy h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.4vw, 4rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .split-heading > p,
  .feature-intro > p,
  .download-copy p,
  .download-actions p {
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .workflow-card,
  .faq-item {
    min-height: 240px;
    padding: var(--space-6);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.018)),
      var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .workflow-card span {
    display: inline-flex;
    margin-bottom: var(--space-10);
    color: rgba(var(--app-accent-rgb), 0.58);
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 800;
    line-height: 1;
  }

  .workflow-card h3,
  .feature-row h3,
  .faq-item h3 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .workflow-card p,
  .feature-row p,
  .faq-item p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .feature-section {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.018), rgba(255, 255, 255, 0));
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .feature-layout {
    display: grid;
    grid-template-columns: minmax(260px, 0.58fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }

  .feature-intro {
    position: sticky;
    top: 110px;
  }

  .feature-list {
    display: grid;
    gap: var(--space-3);
  }

  .feature-row {
    padding: var(--space-5) 0 var(--space-5) var(--space-5);
    border-left: 2px solid rgba(var(--app-accent-rgb), 0.48);
  }

  .download-section {
    padding-block: var(--space-20);
  }

  .download-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-8);
    align-items: center;
    padding: var(--space-8);
    background:
      linear-gradient(135deg, rgba(var(--app-accent-rgb), 0.13), rgba(255, 255, 255, 0.025)),
      var(--color-surface);
    border: 1px solid rgba(var(--app-accent-rgb), 0.28);
    border-radius: var(--radius-lg);
  }

  .download-copy {
    display: flex;
    gap: var(--space-5);
    align-items: center;
  }

  .download-copy p {
    max-width: 620px;
    margin: var(--space-3) 0 0;
  }

  .download-actions {
    display: grid;
    justify-items: end;
    gap: var(--space-4);
  }

  .download-actions p {
    max-width: 360px;
    margin: 0;
    text-align: right;
    font-size: var(--text-sm);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .faq-item {
    min-height: 0;
  }

  .legal-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .legal-links a {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .legal-links a:hover {
    color: var(--color-text);
  }

  @media (max-width: 980px) {
    .hero-grid,
    .feature-layout,
    .download-panel,
    .split-heading {
      grid-template-columns: 1fr;
    }

    .app-hero {
      padding-block-start: var(--space-16);
    }

    .product-stage {
      min-height: 480px;
    }

    .feature-intro {
      position: static;
    }

    .download-actions {
      justify-items: start;
    }

    .download-actions p {
      text-align: left;
    }
  }

  @media (max-width: 720px) {
    .app-container {
      width: min(100% - 32px, 1180px);
    }

    .app-title {
      font-size: clamp(2.8rem, 13vw, 4rem);
    }

    .hero-actions,
    .secondary-action {
      width: 100%;
    }

    .stat-grid,
    .workflow-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }

    .stat-item {
      min-height: 96px;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    .stat-item:last-child {
      border-bottom: none;
    }

    .product-stage {
      min-height: 430px;
    }

    .app-card {
      left: 0;
      right: auto;
      bottom: 26px;
    }

    .download-panel {
      padding: var(--space-6);
    }

    .download-copy {
      align-items: flex-start;
    }
  }

  @media (max-width: 520px) {
    .app-hero {
      min-height: auto;
      padding-block: var(--space-12);
    }

    .product-stage {
      min-height: 360px;
    }

    .device-preview {
      width: min(250px, 74vw);
      border-radius: 34px;
    }

    .device-screen {
      border-radius: 26px;
    }

    .download-copy {
      display: grid;
    }
  }
</style>
