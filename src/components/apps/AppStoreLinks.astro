---
import type { StoreLink } from '@/data/appLanding';

interface Props {
  links: StoreLink[];
  class?: string;
}

const { links, class: className = '' } = Astro.props;
---

<div class:list={['store-links', className]}>
  {links.length > 0 ? (
    links.map((link) => (
      <a href={link.href} target="_blank" rel="noopener noreferrer" class="store-link">
        <span class="store-icon" aria-hidden="true">
          {link.label === 'Google Play' ? (
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.2 2.5c-.2.2-.3.6-.3 1v17c0 .4.1.8.3 1l9.9-9.9-9.9-10.1Zm11 10.9-2.2 2.2-7.8 4.5 8.6-8.6.4.4.4.4.6.5Zm2.9-2.9-2.5 1.4-.6-.6-.5-.5-.5-.5 2.6-2.6 3.4 2c.5.3.5 1.2 0 1.5l-1.9 1.1Zm-4.3-2-8.6-8.6 7.8 4.5 2.2 2.2-.6.5-.4.4-.4.5Z" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.5 12.8c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-1.9-1.5-.2-2.9.9-3.6.9-.8 0-1.9-.9-3.2-.9-1.6 0-3.2 1-4 2.5-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3.1 2.5 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.7-1-2.7-4Zm-2.5-7.2c.7-.8 1.1-1.9 1-3-.9 0-2 .6-2.7 1.4-.6.7-1.1 1.9-1 3 .9.1 1.9-.5 2.7-1.4Z" />
            </svg>
          )}
        </span>
        <span>{link.label}</span>
      </a>
    ))
  ) : (
    <span class="store-link disabled" aria-disabled="true">Store links coming soon</span>
  )}
</div>

<style>
  .store-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .store-link {
    min-height: 48px;
    min-width: 166px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    color: var(--app-accent-contrast, var(--color-accent-contrast));
    background: var(--app-accent, var(--color-accent));
    border: 1px solid rgba(var(--app-accent-rgb, 245, 230, 211), 0.72);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .store-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 32px rgba(var(--app-accent-rgb, 245, 230, 211), 0.18);
  }

  .store-link.disabled {
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--color-border);
    cursor: not-allowed;
  }

  .store-icon {
    width: 20px;
    height: 20px;
    display: inline-flex;
    flex: 0 0 auto;
  }

  .store-icon svg {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 520px) {
    .store-links,
    .store-link {
      width: 100%;
    }
  }
</style>
