---
/**
 * ProjectCard - Product/catalog card for apps and work
 */
import Tag from '@/components/ui/Tag.astro';

interface Props {
  slug: string;
  title: string;
  subtitle?: string;
  tagline: string;
  coverImage: string;
  logo?: string;
  category?: string;
  type: 'app' | 'website' | 'research' | 'open_source';
  platforms: ('web' | 'ios' | 'android')[];
  tech: string[];
  featured?: boolean;
  status?: 'live' | 'in_progress' | 'archived' | 'coming_soon';
  priority?: 'high' | 'auto';
  class?: string;
}

const {
  slug,
  title,
  tagline,
  coverImage,
  logo,
  category,
  type,
  platforms,
  featured = false,
  status = 'live',
  priority = 'auto',
  class: className = '',
  ...rest
} = Astro.props;

const prioritized = featured || priority === 'high';

const base = import.meta.env.BASE_URL;
const baseUrl = type === 'app' ? `${base}apps` : `${base}work`;
const resolvedCoverImage = coverImage.startsWith('/') ? `${base}${coverImage.slice(1)}` : coverImage;
const resolvedLogo = (logo ?? coverImage).startsWith('/')
  ? `${base}${(logo ?? coverImage).slice(1)}`
  : (logo ?? coverImage);

const statusLabels: Record<NonNullable<Props['status']>, string> = {
  live: 'Live',
  in_progress: 'In development',
  archived: 'Archived',
  coming_soon: 'Coming soon'
};

const platformLabels: Record<Props['platforms'][number], string> = {
  ios: 'iOS',
  android: 'Android',
  web: 'Web'
};
---

<a 
  href={`${baseUrl}/${slug}`} 
  class:list={['project-card', { 'project-featured': featured, 'coming-soon': status === 'coming_soon' }, className]}
  {...rest}
>
  <div class="card-content">
    <div class="card-header">
      <img
        class="card-icon"
        src={resolvedLogo}
        alt=""
        width="56"
        height="56"
        loading={prioritized ? 'eager' : 'lazy'}
        fetchpriority={prioritized ? 'high' : 'auto'}
        decoding="async"
      />
      <div class="card-title-group">
        <h3 class="card-title">{title}</h3>
        <p class="card-meta">{category ?? Astro.props.subtitle ?? 'NekoCode app'}</p>
      </div>
      <Tag variant={status === 'coming_soon' ? 'outline' : 'accent'} size="sm">
        {statusLabels[status]}
      </Tag>
    </div>

    <p class="card-tagline">{tagline}</p>

    <div class="card-media">
      <img
        src={resolvedCoverImage}
        alt={`${title} app preview`}
        loading={prioritized ? 'eager' : 'lazy'}
        fetchpriority={prioritized ? 'high' : 'auto'}
        decoding="async"
      />
    </div>

    <div class="card-footer">
      <div class="platform-list" aria-label={`${title} platforms`}>
        {platforms.map((platform) => (
          <span>{platformLabels[platform]}</span>
        ))}
      </div>
      <span class="card-action">{type === 'app' ? 'Open app page' : 'View page'}</span>
    </div>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    color: var(--color-text);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.018)),
      var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    transition:
      transform var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      background var(--duration-normal) var(--ease-out);
  }
  
  .project-card:hover {
    border-color: rgba(245, 230, 211, 0.46);
    transform: translateY(-3px);
  }
  
  .card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-5);
    padding: var(--space-5);
  }
  
  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .card-icon {
    width: 56px;
    height: 56px;
    flex: 0 0 auto;
    padding: 2px;
    object-fit: cover;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
  }

  .card-title-group {
    min-width: 0;
    flex: 1;
  }
  
  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-text);
    margin: 0;
  }

  .card-meta {
    margin-top: var(--space-1);
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  
  .card-tagline {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .card-media {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    padding: var(--space-4);
    background:
      radial-gradient(circle at 50% 28%, rgba(245, 230, 211, 0.12), transparent 62%),
      rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .card-footer,
  .platform-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .card-footer {
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: auto;
  }

  .platform-list span {
    display: inline-flex;
    padding: var(--space-1) var(--space-2);
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1.3;
  }

  .card-action {
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  /* Coming Soon state */
  .coming-soon {
    opacity: 0.9;
  }

  @media (max-width: 520px) {
    .card-header {
      align-items: flex-start;
    }

    .card-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
    }

    .card-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
