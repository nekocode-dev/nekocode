---
const base = import.meta.env.BASE_URL;
const links = [
  { label: 'Support', href: 'support' },
  { label: 'Privacy', href: 'privacy' },
  { label: 'Terms', href: 'terms' }
];
---

<header class="nav-header">
  <nav class="nav glass" aria-label="Chickubo navigation">
    <a href={`${base}apps/chickubo/`} class="nav-logo" aria-label="Chickubo Home">
      <img src={`${base}assets/projects/chickubo/icon.webp`} alt="" width="40" height="40" />
      <span>Chickubo</span>
    </a>
    <div class="nav-links">
      {links.map(link => <a href={`${base}apps/chickubo/${link.href}/`} class="nav-link" aria-current={Astro.url.pathname.replace(/\/$/, '').endsWith(`/chickubo/${link.href}`) ? 'page' : undefined}>{link.label}</a>)}
    </div>
    <a href={base} class="back-to-portfolio">← NekoCode</a>
  </nav>
</header>

<style>
  .nav-header { position: sticky; top: 0; z-index: 100; padding: var(--space-3); }
  .nav { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-3) var(--space-6); border-radius: var(--radius-xl); max-width: var(--container-max); margin-inline: auto; }
  .glass { background: rgba(12, 12, 16, .94); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, .1); }
  .nav-logo { display: inline-flex; align-items: center; gap: var(--space-3); font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; }
  .nav-logo img { border-radius: 10px; object-fit: cover; }
  .nav-links { display: flex; align-items: center; gap: var(--space-1); }
  .nav-link, .back-to-portfolio { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: var(--space-2) var(--space-4); border-radius: var(--radius-md); font-size: var(--text-sm); font-weight: 500; }
  .nav-link { color: var(--color-text-secondary); }
  .nav-link:hover, .nav-link[aria-current="page"] { color: var(--color-text); background: var(--color-border-subtle); }
  .back-to-portfolio { color: var(--color-accent); border: 1px solid var(--color-accent); white-space: nowrap; }
  .back-to-portfolio:hover { background: var(--color-accent); color: var(--color-accent-contrast); }
  @media (max-width: 600px) {
    .nav { flex-wrap: wrap; padding-inline: var(--space-3); gap: var(--space-2); }
    .nav-logo { margin-right: auto; }
    .nav-links { order: 3; width: 100%; justify-content: space-between; border-top: 1px solid var(--color-border); padding-top: var(--space-2); }
    .nav-link { flex: 1; }
    .back-to-portfolio { padding-inline: var(--space-3); font-size: var(--text-xs); }
  }
</style>
