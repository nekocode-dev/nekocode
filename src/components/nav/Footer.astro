---
import StudioIcon from '@/components/ui/StudioIcon.astro';
import VisitorCounter from '@/components/VisitorCounter.astro';
interface SocialLink { label: string; href: string; icon: 'github' | 'linkedin' | 'twitter' | 'email'; }
interface Props { socials?: SocialLink[]; showVisitorCounter?: boolean; }
const { showVisitorCounter = true, socials = [
  { label: 'GitHub', href: 'https://github.com/nekocode-dev', icon: 'github' },
  { label: 'Email', href: 'mailto:hello@nekocode.dev', icon: 'email' }
] } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentYear = new Date().getFullYear();
const links = [{ label: 'Home', href: '' }, { label: 'Apps', href: 'apps' }, { label: 'Team', href: 'team' }, { label: 'Contact', href: 'contact' }];
---
<footer class="footer">
  <div class="footer-content">
    <div class="footer-brand">
      <a href={base} class="footer-logo"><span class="logo-mark"><img src={`${base}Nekocode.png`} alt="" width="44" height="44" /></span><span>NekoCode</span></a>
      <p>Nine lives of code.</p>
    </div>
    <nav class="footer-nav" aria-label="Footer navigation">{links.map(link => <a href={`${base}${link.href}`}>{link.label}</a>)}</nav>
    <div class="footer-social">
      {socials.map(social => <a href={social.href} class="social-link" aria-label={social.label} target={social.href.startsWith('http') ? '_blank' : undefined} rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
        {social.icon === 'linkedin' ? <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM3 9h4v12H3Zm6 0h4v2c1-3 8-4 8 3v7h-4v-6c0-3-4-3-4 0v6H9Z"/></svg> : <StudioIcon name={social.icon} size={27} />}
      </a>)}
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {currentYear} NekoCode. Built with craft and care.</p>
    {showVisitorCounter && <VisitorCounter />}
  </div>
</footer>
<style>
  .footer { margin-top: auto; padding-block: 24px 20px; background: var(--color-bg); border-top: 1px solid var(--color-border); }
  .footer-content, .footer-bottom { width: min(100% - 8.8vw, 1536px); margin-inline: auto; }
  .footer-content { display: flex; align-items: center; gap: 38px; min-height: 44px; }
  .footer-brand { display: flex; align-items: center; gap: 24px; margin-right: auto; }
  .footer-logo { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-display); font-size: 22px; font-weight: 700; letter-spacing: -.02em; white-space: nowrap; }
  .logo-mark { width: 44px; height: 44px; flex: 0 0 auto; display: grid; place-items: center; overflow: hidden; background: #fff; border-radius: 50%; }
  .footer-logo img { width: 44px; height: 44px; transform: scale(1.5); }
  .footer-brand p { border-left: 1px solid var(--color-border); padding: 8px 0 8px 24px; font-size: 14px; color: var(--color-text-secondary); }
  .footer-nav { display: flex; align-items: center; gap: 34px; }
  .footer-nav a { min-height: 44px; display: flex; align-items: center; font-size: 14px; color: var(--color-text-secondary); }
  .footer-nav a:hover { color: var(--color-text); text-decoration: underline; text-underline-offset: 5px; }
  .footer-social { display: flex; align-items: center; gap: 20px; }
  .social-link { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 9px; transition: background 180ms ease; }
  .social-link:hover { background: var(--color-border-subtle); }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 20px; padding-top: 17px; border-top: 1px solid var(--color-border); }
  .footer-bottom p { font-size: 12px; color: var(--color-muted); }
  @media (max-width: 1100px) { .footer-content { flex-wrap: wrap; gap: 12px 30px; } .footer-brand { width: 100%; } .footer-social { margin-left: auto; } }
  @media (max-width: 1000px) { .footer-content, .footer-bottom { width: calc(100% - 48px); } }
  @media (max-width: 560px) { .footer-content, .footer-bottom { width: calc(100% - 40px); } .footer-content { gap: 12px; } .footer-brand { flex-wrap: wrap; gap: 4px 16px; } .footer-brand p { border: 0; padding: 0; } .footer-logo { font-size: 21px; } .footer-nav { gap: 18px; } .footer-nav a { font-size: 13px; } .footer-social { gap: 2px; } .social-link { width: 38px; } .footer-bottom { flex-direction: column; align-items: flex-start; gap: 10px; margin-top: 16px; } }
  @media (max-width: 360px) { .footer-social { margin-left: 0; } }
</style>
