---
import StudioIcon from '@/components/ui/StudioIcon.astro';
interface NavItem { label: string; href: string; isActive?: boolean; }
interface Props { items?: NavItem[]; }
const { items = [
  { label: 'Home', href: '/' },
  { label: 'Apps', href: '/apps' },
  { label: 'Team', href: '/team' },
  { label: 'Contact', href: '/contact' }
] } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---
<header class="nav-header">
  <nav class="nav" aria-label="Main navigation">
    <a href={base} class="nav-logo" aria-label="NekoCode Home">
      <span class="logo-mark"><img src={`${base}Nekocode.png`} alt="" width="52" height="52" /></span><span>NekoCode</span>
    </a>
    <ul class="nav-links" role="list">
      {items.map(item => <li><a href={`${base}${item.href.slice(1)}`} class:list={['nav-link', { active: item.isActive ?? isActive(item.href) }]} aria-current={(item.isActive ?? isActive(item.href)) ? 'page' : undefined}>{item.label}</a></li>)}
    </ul>
    <div class="nav-actions">
      <a class="build-link" href={`${base}contact`}>Let’s Build <StudioIcon name="arrow" size={23} /></a>
      <button class="mobile-menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-mobile-toggle><span></span><span></span><span></span></button>
    </div>
  </nav>
  <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile navigation" data-mobile-menu hidden>
    <ul role="list">{items.map(item => <li><a href={`${base}${item.href.slice(1)}`} class:list={['mobile-link', { active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>)}</ul>
    <a href={`${base}contact`} class="mobile-build">Let’s Build <StudioIcon name="arrow" size={20} /></a>
  </nav>
</header>
<style>
  .nav-header { position: sticky; top: 0; z-index: 100; background: var(--color-bg); border-bottom: 1px solid var(--color-border); }
  .nav { width: min(100% - 8.8vw, 1536px); min-height: 76px; margin-inline: auto; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 30px; }
  .nav-logo { display: inline-flex; align-items: center; gap: 13px; width: fit-content; font-family: var(--font-display); font-size: 30px; font-weight: 700; letter-spacing: -.025em; }
  .logo-mark { width: 52px; height: 52px; display: grid; place-items: center; overflow: hidden; background: #fff; border-radius: 50%; }
  .nav-logo img { width: 52px; height: 52px; transform: scale(1.5); }
  .nav-links { display: flex; align-items: center; gap: 51px; }
  .nav-link { position: relative; display: block; padding: 24px 0; font-size: 18px; }
  .nav-link::after { content: ''; position: absolute; bottom: 14px; left: 0; right: 0; height: 2px; background: currentColor; transform: scaleX(0); transition: transform 180ms ease; }
  .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }
  .nav-link.active { font-weight: 600; }
  .nav-actions { justify-self: end; display: flex; align-items: center; gap: 12px; }
  .build-link { display: inline-flex; align-items: center; justify-content: center; gap: 13px; min-height: 52px; min-width: 180px; padding: 12px 24px; border-radius: 12px; background: linear-gradient(135deg, #1b1e27, #12151c); color: #fff; font-size: 17px; font-weight: 500; transition: background 180ms ease; }
  .build-link:hover { background: #303644; }
  .mobile-menu-toggle { display: none; width: 44px; height: 44px; align-items: center; justify-content: center; flex-direction: column; gap: 5px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-bg); color: var(--color-text); cursor: pointer; }
  .mobile-menu-toggle span { width: 20px; height: 2px; background: currentColor; transition: transform 150ms ease; }
  .mobile-menu-toggle[aria-expanded="true"] span:first-child { transform: translateY(7px) rotate(45deg); }
  .mobile-menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .mobile-menu-toggle[aria-expanded="true"] span:last-child { transform: translateY(-7px) rotate(-45deg); }
  .mobile-menu { position: absolute; top: 100%; left: 0; right: 0; padding: 16px 24px 24px; background: var(--color-bg); border-bottom: 1px solid var(--color-border); box-shadow: 0 12px 20px #0000000a; }
  .mobile-menu[hidden] { display: none; }
  .mobile-link { display: block; padding: 12px; border-radius: 8px; }
  .mobile-link:hover, .mobile-link.active { background: var(--color-border-subtle); }
  .mobile-build { margin-top: 12px; padding: 12px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--color-border); }
  @media (max-width: 1100px) { .nav-links { gap: 28px; } .nav-logo { font-size: 26px; } .build-link { min-width: 150px; } }
  @media (max-width: 1000px) { .nav { width: calc(100% - 48px); } }
  @media (max-width: 860px) { .nav { display: flex; justify-content: space-between; min-height: 72px; } .nav-links { display: none; } .mobile-menu-toggle { display: flex; } }
  @media (max-width: 560px) { .nav { width: calc(100% - 40px); min-height: 70px; } .nav-logo { font-size: 25px; gap: 9px; } .logo-mark, .nav-logo img { width: 42px; height: 42px; } .build-link { display: none; } }
  @media (min-width: 861px) { .mobile-menu { display: none; } }
</style>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (menu) menu.hidden = !open;
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
  });
  document.addEventListener('click', event => {
    if (event.target instanceof Node && !document.querySelector('.nav-header')?.contains(event.target)) setOpen(false);
  });
</script>
