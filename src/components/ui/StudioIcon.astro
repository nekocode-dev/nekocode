  {name === 'heart' && <path d="M12 22 2.5 12.5C-4 6 5-2 12 5c7-7 16 1 9.5 7.5Z"/>}
  {name === 'ios' && <path d="M17.5 12.8c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-1.9-1.5-.2-2.9.9-3.6.9-.8 0-1.9-.9-3.2-.9-1.6 0-3.2 1-4 2.5-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3.1 2.5 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8-.1 0-2.7-1-2.7-4Zm-2.5-7.2c.7-.8 1.1-1.9 1-3-.9 0-2 .6-2.7 1.4-.6.7-1.1 1.9-1 3 .9.1 1.9-.5 2.7-1.4Z"/>}
  {name === 'android' && <><path d="m7 2 2 3m8-3-2 3" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/><path d="M5 10a7 7 0 0 1 14 0Zm0 1h14v8H5Z"/><rect x="2" y="11" width="2" height="8" rx="1"/><rect x="20" y="11" width="2" height="8" rx="1"/><rect x="7" y="18" width="3" height="6" rx="1.5"/><rect x="14" y="18" width="3" height="6" rx="1.5"/><circle cx="9" cy="7.5" r=".8" fill="#fff"/><circle cx="15" cy="7.5" r=".8" fill="#fff"/></>}
  {name === 'web' && <g fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><ellipse cx="12" cy="12" rx="4" ry="10"/><path d="M2 12h20"/></g>}
  {name === 'github' && <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.79-.26.79-.58v-2.23c-3.34.73-4.03-1.42-4.03-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.21.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.31.76-1.6-2.66-.31-5.47-1.34-5.47-5.94 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0 1 12 5.8c1.02 0 2.05.14 3 .4 2.3-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.82 1.1.82 2.22v3.3c0 .32.19.69.8.58A12 12 0 0 0 24 12C24 5.37 18.63 0 12 0Z"/>}
