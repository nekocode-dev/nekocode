---
interface Props {
  name: 'arrow' | 'lock' | 'people' | 'heart' | 'ios' | 'android' | 'web' | 'github' | 'twitter' | 'email';
  size?: number;
}
const { name, size = 24 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
