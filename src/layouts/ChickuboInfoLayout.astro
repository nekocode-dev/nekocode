---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ChickuboNav from '@/components/nav/ChickuboNav.astro';
import Footer from '@/components/nav/Footer.astro';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';

interface Props { title: string; description: string; icon?: string; updated?: boolean; }
const { title, description, icon = '🐔', updated = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={title === 'Chickubo' ? 'Chickubo: Cozy Chicken Farm' : `${title} | Chickubo`} description={description} image="/assets/projects/chickubo/icon.webp" imageAlt="Chickubo white hen on a cozy farm">
  <ChickuboNav slot="header" />
  <Section size="lg" class="chickubo-page">
    <Container size="narrow">
      <a href={`${base}apps/`} class="back-link">← NekoCode apps</a>
      <div class="info-header glass-panel">
        <span class="info-icon" aria-hidden="true">{icon}</span>
        <div>
          <h1 class="text-title-1">{title}</h1>
          <p class="info-subtitle">Chickubo: Cozy Chicken Farm by NekoCode</p>
        </div>
        {updated && <p class="last-updated">Last updated: <time datetime="2026-10-09">October 9, 2026</time></p>}
      </div>
      <div class="info-content glass-panel"><slot /></div>
      <nav class="page-links" aria-label="Chickubo help and policies">
        <a href={`${base}apps/chickubo/support/`}>Support</a>
        <a href={`${base}apps/chickubo/privacy/`}>Privacy Policy</a>
        <a href={`${base}apps/chickubo/terms/`}>Terms of Service</a>
      </nav>
    </Container>
  </Section>
  <Footer slot="footer" showVisitorCounter={false} />
</BaseLayout>

<style>
  .back-link { display: inline-block; margin-bottom: var(--space-6); color: var(--color-muted); font-size: var(--text-sm); }
  .back-link:hover { color: var(--color-text); }
  .glass-panel { background: rgba(255, 255, 255, .03); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, .08); border-radius: var(--radius-xl); }
  .info-header { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); padding: var(--space-6); margin-bottom: var(--space-8); }
  .info-icon { font-size: var(--text-3xl); }
  .info-subtitle { color: var(--color-muted); font-size: var(--text-sm); margin: var(--space-2) 0 0; }
  .last-updated { width: 100%; font-size: var(--text-xs); color: var(--color-accent); }
  .info-content { padding: var(--space-6); line-height: 1.8; overflow-wrap: anywhere; }
  .info-content :global(section) { margin-bottom: var(--space-10); }
  .info-content :global(section:last-child) { margin-bottom: 0; }
  .info-content :global(h2) { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; color: var(--color-accent); margin-bottom: var(--space-4); padding-bottom: var(--space-2); border-bottom: 1px solid var(--color-border); }
  .info-content :global(p), .info-content :global(ul), .info-content :global(ol) { color: var(--color-text-secondary); margin-bottom: var(--space-4); }
  .info-content :global(ul), .info-content :global(ol) { padding-left: var(--space-6); }
  .info-content :global(li) { padding: var(--space-1) 0; }
  .info-content :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .info-content :global(.highlight-box) { padding: var(--space-6); border-radius: var(--radius-lg); margin-bottom: var(--space-8); background: rgba(var(--color-accent-rgb, 193, 154, 107), .1); border: 1px solid rgba(var(--color-accent-rgb, 193, 154, 107), .3); }
  .info-content :global(.highlight-box p:last-child) { margin-bottom: 0; }
  .page-links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-top: var(--space-6); }
  .page-links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-accent); font-size: var(--text-sm); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 600px) { .info-content, .info-header { padding: var(--space-4); } .info-content :global(.highlight-box) { padding: var(--space-4); } }
</style>
