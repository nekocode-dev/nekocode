---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppLandingContent from '@/components/apps/AppLandingContent.astro';
import FlipFocusTestimonials from '@/components/cards/FlipFocusTestimonials.astro';
import FlipFocusNav from '@/components/nav/FlipFocusNav.astro';
import Footer from '@/components/nav/Footer.astro';
import { appLandingPages, appStructuredData } from '@/data/appLanding';

const app = appLandingPages.flipfocus;
const siteURL = new URL(Astro.site ?? 'https://nekocode.dev');
const pageURL = new URL(Astro.url.pathname, siteURL).href;
---

<BaseLayout
  title={app.metaTitle}
  description={app.metaDescription}
  image={app.heroImage}
  imageAlt={app.heroImageAlt}
  mainEntityId={`${pageURL}#app`}
  structuredData={appStructuredData(app, pageURL, siteURL.href)}
>
  <FlipFocusNav slot="header" />
  <AppLandingContent app={app} />
  <FlipFocusTestimonials />
  <Footer slot="footer" />
</BaseLayout>
