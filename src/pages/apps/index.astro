---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NavBar from '@/components/nav/NavBar.astro';
import Footer from '@/components/nav/Footer.astro';
import Container from '@/components/layout/Container.astro';
import Section from '@/components/layout/Section.astro';
import ProjectCard from '@/components/cards/ProjectCard.astro';
import Tag from '@/components/ui/Tag.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type Project = CollectionEntry<'projects'>;

// Get apps only
const allProjects: Project[] = await getCollection('projects');
const apps: Project[] = allProjects.filter((project: Project) => project.data.type === 'app');
apps.sort((a: Project, b: Project) => {
  if (a.slug === 'frendlyst') return -1;
  if (b.slug === 'frendlyst') return 1;
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return a.data.title.localeCompare(b.data.title);
});

// Extract categories
const categories = [...new Set(apps.map((project: Project) => project.data.category).filter((category): category is string => Boolean(category)))];
---

<BaseLayout
  title="NekoCode App Catalog"
  description="Compare the live and upcoming NekoCode apps across social discovery, learning, wellness, caffeine tracking, and gamified fitness."
>
  <NavBar slot="header" />
  
  <Section size="lg" class="catalog-hero">
    <Container>
      <div class="page-header">
        <div>
          <p class="catalog-label">Mobile products</p>
          <h1 class="text-title-1">NekoCode App Catalog</h1>
        </div>
        <p class="page-description">
          Compare the live and upcoming NekoCode apps by platform, status, product loop, and download path.
        </p>
      </div>

      <div class="catalog-summary" aria-label="NekoCode app catalog summary">
        <div>
          <strong>{apps.filter((app: Project) => app.data.status === 'live').length}</strong>
          <span>Live apps</span>
        </div>
        <div>
          <strong>{apps.length}</strong>
          <span>Products listed</span>
        </div>
        <div>
          <strong>4</strong>
          <span>App categories</span>
        </div>
      </div>
      
      <!-- Category Chips -->
      {categories.length > 0 && (
        <div class="category-bar">
          <Tag variant="accent">All</Tag>
          {categories.map(cat => (
            <Tag variant="outline">{cat}</Tag>
          ))}
        </div>
      )}
      
      <!-- Apps Grid -->
      <div class="apps-grid">
        {apps.map((project: Project, index: number) => (
          <ProjectCard
            slug={project.slug}
            title={project.data.title}
            tagline={project.data.tagline}
            coverImage={project.data.media.coverImage}
            logo={project.data.media.logo}
            category={project.data.category}
            type={project.data.type}
            platforms={project.data.platforms}
            tech={project.data.tech}
            status={project.data.status}
            featured={project.data.featured}
            priority={index < 3 ? 'high' : 'auto'}
            class={`reveal stagger-${(index % 8) + 1}`}
          />
        ))}
      </div>
      
      {apps.length === 0 && (
        <div class="empty-state">
          <p>No apps to show yet. Check back soon!</p>
        </div>
      )}
    </Container>
  </Section>
  
  <Footer slot="footer" />
</BaseLayout>

<style>
  .catalog-hero {
    min-height: calc(100svh - 88px);
  }

  .page-header {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(320px, 0.55fr);
    gap: var(--space-8);
    align-items: end;
    margin-bottom: var(--space-8);
  }
  
  .page-header h1 {
    margin-bottom: var(--space-3);
  }

  .catalog-label {
    margin-bottom: var(--space-3);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  
  .page-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 520px;
    line-height: 1.7;
  }

  .catalog-summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: var(--space-8);
    border-block: 1px solid var(--color-border);
  }

  .catalog-summary div {
    min-height: 104px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-5);
    border-right: 1px solid var(--color-border);
  }

  .catalog-summary div:last-child {
    border-right: none;
  }

  .catalog-summary strong {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: 1;
    color: var(--color-accent);
  }

  .catalog-summary span {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  
  .category-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }
  
  .empty-state {
    text-align: center;
    padding: var(--space-16);
    color: var(--color-muted);
  }

  @media (max-width: 980px) {
    .apps-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 780px) {
    .page-header,
    .catalog-summary {
      grid-template-columns: 1fr;
    }

    .apps-grid {
      grid-template-columns: 1fr;
    }

    .catalog-summary div {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    .catalog-summary div:last-child {
      border-bottom: none;
    }
  }
</style>
