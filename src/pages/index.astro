---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NavBar from '@/components/nav/NavBar.astro';
import Footer from '@/components/nav/Footer.astro';
import StudioIcon from '@/components/ui/StudioIcon.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const base = import.meta.env.BASE_URL;
const assetURL = (path: string) => path.startsWith('/') ? `${base}${path.slice(1)}` : path;
type Project = CollectionEntry<'projects'>;
const projects: Project[] = await getCollection('projects');
const order = ['beanbop', 'flipfocus'];
const cardCopy: Record<string, string> = {
  beanbop: 'Track your caffeine, build mindful habits, and find your daily balance.',
  flipfocus: 'Turn notes into flashcards and make learning stick with spaced repetition.'
};
const apps = order.flatMap(slug => {
  const project = projects.find(project => project.slug === slug);
  return project ? [project] : [];
});
const platformLabels = { ios: 'iOS', android: 'Android', web: 'Web' };
const statusLabels: Record<string, string> = { live: 'Live', in_progress: 'In development', coming_soon: 'Coming soon', archived: 'Archived' };
---

<BaseLayout
  title="NekoCode Apps | Privacy-First Mobile App Showcase"
  description="Explore BeanBop and FlipFocus by NekoCode. Simple, useful, and playful apps for a kinder tomorrow, with privacy in mind."
  appearance="studio"
>
  <NavBar slot="header" />

  <section class="studio-hero" aria-labelledby="hero-title" data-testid="studio-hero">
    <picture class="hero-art">
      <img
        src={`${base}assets/studio/nekocode-hero.webp`}
        alt="Two cat characters creating apps together in a bright NekoCode studio."
        width="2055" height="765" loading="eager" fetchpriority="high" decoding="async"
      />
    </picture>
    <div class="studio-container hero-inner">
      <div class="hero-copy">
        <h1 id="hero-title">NekoCode</h1>
        <p class="hero-tagline">Apps for a kinder tomorrow.</p>
        <p class="hero-description">We build simple, useful, and playful apps<br class="desktop-break" /> with privacy in mind.</p>
        <div class="hero-actions" data-testid="hero-actions">
          <a class="studio-button primary" href={`${base}apps`}>Explore Our Apps <StudioIcon name="arrow" /></a>
          <a class="studio-button secondary" href={`${base}contact`}>Get in Touch</a>
        </div>
        <ul class="studio-values" aria-label="Our values">
          <li><StudioIcon name="lock" size={29} /><span>Privacy-first</span></li>
          <li><StudioIcon name="people" size={32} /><span>People-focused</span></li>
          <li><StudioIcon name="heart" size={30} /><span>Built with care</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="featured-section" aria-labelledby="featured-title">
    <div class="studio-container">
      <div class="featured-heading">
        <div><p class="eyebrow">/ APPS</p><h2 id="featured-title">Featured Apps</h2></div>
        <a class="view-apps" href={`${base}apps`}>View all apps <StudioIcon name="arrow" size={20} /></a>
      </div>
      <div class="featured-grid" data-testid="featured-apps">
        {apps.map(project => (
          <a class="featured-card" href={`${base}apps/${project.slug}`} aria-label={`${project.data.title} — ${statusLabels[project.data.status]}. Learn more.`}>
            <div class="app-body">
              <img class="app-icon" src={assetURL(project.data.media.logo ?? project.data.media.coverImage)} alt="" width="80" height="80" loading="eager" />
              <div class="app-copy"><h3>{project.data.title}</h3><p>{cardCopy[project.slug] ?? project.data.tagline}</p></div>
            </div>
            <div class="app-footer">
              <ul class="app-platforms" aria-label={`${project.data.title} platforms`}>
                {(['ios', 'android', 'web'] as const).filter(platform => project.data.platforms.includes(platform)).map(platform => (
                  <li><StudioIcon name={platform} size={18} /><span>{platformLabels[platform]}{project.slug === 'flipfocus' && platform === 'ios' ? ' soon' : ''}</span></li>
                ))}
              </ul>
              <span class="app-action">Explore app <StudioIcon name="arrow" size={20} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .studio-container { width: min(100% - 8.8vw, 1536px); margin-inline: auto; }
  .studio-hero { position: relative; isolation: isolate; min-height: clamp(500px, 34.9vw, 600px); overflow: hidden; background: #fff; }
  .hero-art { position: absolute; inset: 0; z-index: -2; }
  .hero-art img { width: 100%; height: 100%; object-fit: cover; object-position: right center; }
  .studio-hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, #fff 29%, rgba(255,255,255,.85) 35%, rgba(255,255,255,.1) 45%, transparent 50%); pointer-events: none; }
  .hero-inner { min-height: inherit; display: flex; align-items: center; }
  .hero-copy { padding-block: 48px; width: 590px; max-width: 46%; }
  h1 { font-family: var(--font-display); font-size: clamp(76px, 6.8vw, 114px); font-weight: 800; line-height: 1.03; letter-spacing: -.045em; }
  .hero-tagline { margin-top: 6px; font-family: var(--font-display); font-size: clamp(26px, 2.4vw, 39px); font-weight: 500; line-height: 1.2; letter-spacing: -.01em; }
  .hero-description { margin-top: 15px; color: #343b50; font-size: clamp(18px, 1.42vw, 23px); line-height: 1.5; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 19px; margin-top: 24px; }
  .studio-button { min-height: 56px; display: inline-flex; align-items: center; justify-content: center; gap: 15px; padding: 13px 30px; border: 1px solid #171a23; border-radius: 12px; font-size: 18px; font-weight: 500; transition: background 180ms ease, transform 180ms ease, box-shadow 180ms ease; }
  .primary { color: #fff; background: linear-gradient(135deg, #191d27, #10131b); box-shadow: 0 4px 12px #10131b0a; }
  .secondary { min-width: 180px; background: #ffffffc9; }
  .studio-button:hover { transform: translateY(-2px); box-shadow: 0 7px 18px #10131b15; }
  .primary:hover { background: #303644; }
  .secondary:hover { background: #f5f5f7; }
  .studio-values { display: flex; align-items: center; flex-wrap: wrap; gap: 28px; margin-top: 38px; }
  .studio-values li { display: flex; align-items: center; gap: 11px; font-size: 14px; white-space: nowrap; }
  .featured-section { padding-block: 30px 38px; background: #faf8f6; border-top: 1px solid #f1eeeb; }
  .featured-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
  .eyebrow { font-size: 13px; letter-spacing: .17em; color: #343b50; }
  h2 { font-family: var(--font-display); font-size: 34px; font-weight: 700; line-height: 1.2; letter-spacing: -.02em; margin-top: 3px; }
  .view-apps { display: inline-flex; align-items: center; gap: 4px; font-size: 16px; min-height: 44px; margin-top: 20px; }
  .view-apps:hover { text-decoration: underline; text-underline-offset: 5px; }
  .featured-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .featured-card { display: flex; flex-direction: column; gap: 22px; padding: 24px 26px 20px; border: 1px solid #e4e3e6; border-radius: 18px; background: #fff; box-shadow: 0 2px 4px #25232b02; transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease; }
  .featured-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px #21242e0b; border-color: #c8cbd4; }
  .app-body { display: flex; align-items: center; gap: 20px; }
  .app-icon { width: 80px; height: 80px; flex: 0 0 auto; border-radius: 20px; object-fit: contain; }
  .app-copy { min-width: 0; }
  h3 { font-family: var(--font-display); font-size: 23px; font-weight: 700; line-height: 1.2; letter-spacing: -.02em; }
  .app-copy p { margin-top: 7px; color: #535767; font-size: 15px; line-height: 1.55; max-width: 400px; text-wrap: pretty; }
  .app-footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: auto; padding-top: 16px; border-top: 1px solid #efedf0; }
  .app-platforms { display: flex; align-items: center; gap: 16px; }
  .app-platforms li { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #535767; white-space: nowrap; }
  .app-platforms :global(svg) { color: #171a23; }
  .app-action { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; white-space: nowrap; }
  .app-action :global(svg) { transition: transform 180ms ease; }
  .featured-card:hover .app-action :global(svg) { transform: translateX(3px); }
  @media (min-width: 1800px) { .hero-copy { max-width: 42%; } }
  @media (max-width: 1250px) {
    .hero-copy { max-width: 48%; }
    .hero-tagline { font-size: 28px; }
    .studio-values { gap: 18px; }
    .studio-values li { gap: 8px; font-size: 12px; }
    .studio-button { padding-inline: 22px; font-size: 16px; }
    .featured-card { padding: 22px; }
    .app-body { gap: 16px; }
    .app-icon { width: 72px; height: 72px; border-radius: 18px; }
  }
  @media (max-width: 1000px) {
    .studio-container { width: calc(100% - 48px); }
    .featured-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero-copy { max-width: 56%; }
    .studio-hero::before { background: linear-gradient(90deg,#fff 25%,#ffffffed 42%,#ffffff70 54%,transparent 68%); }
    h1 { font-size: 76px; }
    .hero-tagline { font-size: 27px; }
    .studio-values { gap: 16px; }
    .app-copy p { font-size: 14px; }
    .app-platforms { gap: 12px; }
    .app-action { font-size: 12px; gap: 4px; }
  }
  @media (max-width: 760px) {
    .studio-container { width: calc(100% - 40px); }
    .studio-hero { display: flex; flex-direction: column; min-height: 0; }
    .hero-inner { order: -1; min-height: 0; }
    .hero-copy { max-width: 100%; width: 100%; padding-block: 36px 28px; }
    h1 { font-size: clamp(56px, 12vw, 82px); }
    .hero-tagline { font-size: clamp(23px, 4.9vw, 30px); }
    .hero-description { font-size: 17px; max-width: 400px; }
    .desktop-break { display: none; }
    .hero-actions { gap: 12px; margin-top: 22px; }
    .studio-button { min-height: 52px; font-size: 15px; padding-inline: 20px; }
    .secondary { min-width: 0; }
    .studio-values { gap: 14px 22px; margin-top: 28px; }
    .studio-values li { font-size: 12px; gap: 7px; }
    .studio-values :global(svg) { width: 22px; height: 22px; }
    .hero-art { position: relative; height: auto; aspect-ratio: 1.55; width: 100%; z-index: 0; }
    .hero-art img { object-fit: cover; object-position: right; }
    .studio-hero::before { display: none; }
    .featured-section { padding-block: 26px 36px; }
    h2 { font-size: 29px; }
    .view-apps { font-size: 13px; }
    .featured-grid { grid-template-columns: 1fr; gap: 14px; }
    .featured-card { gap: 20px; padding: 22px; }
  }
  @media (max-width: 560px) {
    .hero-actions { gap: 10px; }
    .studio-button { padding-inline: 18px; font-size: 14px; gap: 10px; }
    .featured-grid { grid-template-columns: 1fr; }
    .featured-card { padding: 20px; }
    .app-body { align-items: flex-start; gap: 15px; }
    .app-icon { width: 64px; height: 64px; border-radius: 16px; }
    h3 { font-size: 21px; }
    .app-copy p { font-size: 14px; }
    .studio-values { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 8px; padding-block: 17px; border-block: 1px solid #efedf0; }
    .studio-values li { flex-direction: column; align-items: center; gap: 8px; font-size: 12px; white-space: normal; text-align: center; }
    .app-footer { gap: 12px; }
  }
  @media (max-width: 360px) {
    .studio-button { width: 100%; }
    .app-footer { align-items: flex-start; flex-direction: column; gap: 14px; }
    .view-apps { font-size: 12px; }
    .studio-values li { font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) { .studio-button, .featured-card { transition: none; } .studio-button:hover, .featured-card:hover { transform: none; } }
</style>
